CREATE OR ALTER PROCEDURE sp_Roles_Listar
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        r.RolID,
        r.Nombre,
        r.Descripcion,
        r.Activo,
        r.FechaCreacion,
        COUNT(u.UsuarioID) AS CantidadUsuarios
    FROM Roles r

    LEFT JOIN Usuarios u
        ON r.RolID = u.RolID

    GROUP BY
        r.RolID,
        r.Nombre,
        r.Descripcion,
        r.Activo,
        r.FechaCreacion

    ORDER BY r.RolID;
END;
GO

-----------------------------------------------------
--Seguridad registrar roles
-----------------------------------------------------
CREATE OR ALTER PROCEDURE sp_Roles_Registrar
    @Nombre VARCHAR(50),
    @Descripcion VARCHAR(200)
AS
BEGIN
    SET NOCOUNT ON;

    -- Verificar si ya existe
    IF EXISTS (
        SELECT 1
        FROM Roles
        WHERE Nombre = @Nombre
    )
    BEGIN
        RAISERROR('El rol ya existe.', 16, 1);
        RETURN;
    END;

    -- Registrar rol
    INSERT INTO Roles
    (
        Nombre,
        Descripcion,
        Activo,
        FechaCreacion
    )
    VALUES
    (
        @Nombre,
        @Descripcion,
        1,
        GETDATE()
    );

    -- Devolver ID generado
    SELECT
        SCOPE_IDENTITY() AS RolID,
        'Rol registrado correctamente.' AS Mensaje;
END;
GO

---------------------------------------------
--Seguridad Actualizar rol
---------------------------------------------
CREATE OR ALTER PROCEDURE sp_Roles_Actualizar
    @RolID INT,
    @Nombre VARCHAR(50),
    @Descripcion VARCHAR(200)
AS
BEGIN
    SET NOCOUNT ON;

    -- Verificar que exista
    IF NOT EXISTS (
        SELECT 1
        FROM Roles
        WHERE RolID = @RolID
    )
    BEGIN
        RAISERROR('El rol no existe.', 16, 1);
        RETURN;
    END;

    -- Verificar nombre duplicado
    IF EXISTS (
        SELECT 1
        FROM Roles
        WHERE Nombre = @Nombre
          AND RolID <> @RolID
    )
    BEGIN
        RAISERROR('Ya existe otro rol con ese nombre.', 16, 1);
        RETURN;
    END;

    -- Actualizar
    UPDATE Roles
    SET
        Nombre = @Nombre,
        Descripcion = @Descripcion
    WHERE RolID = @RolID;

    SELECT
        @RolID AS RolID,
        'Rol actualizado correctamente.' AS Mensaje;
END;
GO

--------------------------------------
--Seguridad Cambiar de estado a rol
--------------------------------------
CREATE OR ALTER PROCEDURE sp_Roles_CambiarEstado
    @RolID INT,
    @Activo INT
AS
BEGIN
    SET NOCOUNT ON;

    -- Verificar que exista el rol
    IF NOT EXISTS (
        SELECT 1
        FROM Roles
        WHERE RolID = @RolID
    )
    BEGIN
        RAISERROR('El rol no existe.', 16, 1);
        RETURN;
    END;

    -- Validar valor
    IF @Activo NOT IN (0, 1)
    BEGIN
        RAISERROR('El estado debe ser 0 (inactivo) o 1 (activo).', 16, 1);
        RETURN;
    END;

    -- No permitir desactivar un rol utilizado por usuarios activos
    IF @Activo = 0
       AND EXISTS (
            SELECT 1
            FROM Usuarios
            WHERE RolID = @RolID
              AND Estado = 'Activo'
       )
    BEGIN
        RAISERROR(
            'No se puede desactivar el rol porque tiene usuarios activos.',
            16,
            1
        );
        RETURN;
    END;

    -- Actualizar estado
    UPDATE Roles
    SET Activo = @Activo
    WHERE RolID = @RolID;

    SELECT
        @RolID AS RolID,
        @Activo AS Activo,
        'Estado del rol actualizado correctamente.' AS Mensaje;
END;
GO

