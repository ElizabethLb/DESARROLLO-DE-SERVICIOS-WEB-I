--Seguridad_BuscarUsurio
------------------------------------
CREATE OR ALTER PROCEDURE sp_Usuarios_Buscar
    @Texto VARCHAR(200)
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        u.UsuarioID,
        CONCAT(u.Nombre, ' ', u.Apellido) AS Usuario,
        u.Nombre,
        u.Apellido,
        u.Email,
        r.RolID,
        r.Nombre AS Rol,
        COUNT(l.LibroID) AS LibrosPublicados,
        u.FechaRegistro,
        u.UltimoAcceso,
        u.Estado,
        u.EsEscritor
    FROM Usuarios u

    INNER JOIN Roles r
        ON u.RolID = r.RolID

    LEFT JOIN Libros l
        ON u.UsuarioID = l.AutorID
        AND l.Estado = 'Publicado'

    WHERE
        u.Nombre LIKE '%' + @Texto + '%'
        OR u.Apellido LIKE '%' + @Texto + '%'
        OR u.Email LIKE '%' + @Texto + '%'
        OR r.Nombre LIKE '%' + @Texto + '%'

    GROUP BY
        u.UsuarioID,
        u.Nombre,
        u.Apellido,
        u.Email,
        r.RolID,
        r.Nombre,
        u.FechaRegistro,
        u.UltimoAcceso,
        u.Estado,
        u.EsEscritor

    ORDER BY u.UsuarioID DESC;
END;
GO

