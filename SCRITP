--Seguridad Listar sesiones activas
---------------------------------------
CREATE OR ALTER PROCEDURE sp_Sesiones_ListarActivas
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        s.SesionID,
        s.UsuarioID,
        CONCAT(u.Nombre, ' ', u.Apellido) AS Usuario,
        u.Email,
        s.IP,
        s.Dispositivo,
        s.FechaInicio,
        s.FechaExpira,
        s.Activa
    FROM Sesiones s

    INNER JOIN Usuarios u
        ON s.UsuarioID = u.UsuarioID

    WHERE s.Activa = 1

    ORDER BY s.FechaInicio DESC;
END;
GO

-----------------------------------------------
--Seguridad serrar sesiones activas
-----------------------------------------------
CREATE OR ALTER PROCEDURE sp_Sesiones_Cerrar
    @SesionID INT
AS
BEGIN
    SET NOCOUNT ON;

    -- Verificar sesión
    IF NOT EXISTS (
        SELECT 1
        FROM Sesiones
        WHERE SesionID = @SesionID
    )
    BEGIN
        RAISERROR('La sesión no existe.', 16, 1);
        RETURN;
    END;

    -- Verificar que esté activa
    IF NOT EXISTS (
        SELECT 1
        FROM Sesiones
        WHERE SesionID = @SesionID
          AND Activa = 1
    )
    BEGIN
        RAISERROR('La sesión ya se encuentra cerrada.', 16, 1);
        RETURN;
    END;

    -- Cerrar sesión
    UPDATE Sesiones
    SET Activa = 0
    WHERE SesionID = @SesionID;

    SELECT
        @SesionID AS SesionID,
        'Sesión cerrada correctamente.' AS Mensaje;
END;
GO
