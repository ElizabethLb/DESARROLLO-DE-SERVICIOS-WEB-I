--------------------------------------
--Actualizar_Usurio
--------------------------------------
USE BookMatchBD;
GO

CREATE OR ALTER PROCEDURE sp_Usuarios_Actualizar
    @UsuarioID INT,
    @Nombre VARCHAR(120),
    @Apellido VARCHAR(120),
    @Email VARCHAR(200),
    @RolID INT,
    @EsEscritor INT,
    @Biografia VARCHAR(MAX) = NULL,
    @FotoPerfil VARCHAR(500) = NULL
AS
BEGIN
    SET NOCOUNT ON;

    -- 1. Verificar que el usuario exista
    IF NOT EXISTS (
        SELECT 1
        FROM Usuarios
        WHERE UsuarioID = @UsuarioID
    )
    BEGIN
        RAISERROR('El usuario no existe.', 16, 1);
        RETURN;
    END;

    -- 2. Verificar que el correo no pertenezca a otro usuario
    IF EXISTS (
        SELECT 1
        FROM Usuarios
        WHERE Email = @Email
          AND UsuarioID <> @UsuarioID
    )
    BEGIN
        RAISERROR('El correo electrónico ya pertenece a otro usuario.', 16, 1);
        RETURN;
    END;

    -- 3. Verificar que el rol exista y esté activo
    IF NOT EXISTS (
        SELECT 1
        FROM Roles
        WHERE RolID = @RolID
          AND Activo = 1
    )
    BEGIN
        RAISERROR('El rol seleccionado no existe o está inactivo.', 16, 1);
        RETURN;
    END;

    -- 4. Actualizar usuario
    UPDATE Usuarios
    SET
        Nombre = @Nombre,
        Apellido = @Apellido,
        Email = @Email,
        RolID = @RolID,
        EsEscritor = @EsEscritor,
        Biografia = @Biografia,
        FotoPerfil = @FotoPerfil
    WHERE UsuarioID = @UsuarioID;

    -- 5. Confirmación
    SELECT
        @UsuarioID AS UsuarioID,
        'Usuario actualizado correctamente.' AS Mensaje;
END;
GO

--------------------------------------------------------------
--Seguridad Activar o desactivar usurio
--------------------------------------------------------------
CREATE OR ALTER PROCEDURE sp_Usuarios_CambiarEstado
    @UsuarioID INT,
    @Estado VARCHAR(20)
AS
BEGIN
    SET NOCOUNT ON;

    -- Verificar que el usuario exista
    IF NOT EXISTS (
        SELECT 1
        FROM Usuarios
        WHERE UsuarioID = @UsuarioID
    )
    BEGIN
        RAISERROR('El usuario no existe.', 16, 1);
        RETURN;
    END;

    -- Validar estado
    IF @Estado NOT IN ('Activo', 'Inactivo', 'Suspendido')
    BEGIN
        RAISERROR('El estado ingresado no es válido.', 16, 1);
        RETURN;
    END;

    -- Actualizar estado
    UPDATE Usuarios
    SET Estado = @Estado
    WHERE UsuarioID = @UsuarioID;

    -- Confirmación
    SELECT
        @UsuarioID AS UsuarioID,
        @Estado AS Estado,
        'Estado del usuario actualizado correctamente.' AS Mensaje;
END;
GO

