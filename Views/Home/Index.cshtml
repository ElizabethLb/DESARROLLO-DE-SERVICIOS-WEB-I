@{
    Layout = null;
}
@model BookMatch.Models.LoginViewModel
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BookMatch - Iniciar sesión</title>
    <style>
            :root {
                --purple-1: #3a0ca3;
                --purple-2: #6a4cff;
                --accent: #8a2be2;
                --muted: #7b6f9b;
            }

            html, body {
                height: 100%;
                margin: 0;
                font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
            }

            .container {
                display: flex;
                min-height: 100vh
            }

            .left {
                flex: 1;
                color: #fff;
                padding: 64px 80px;
                background: linear-gradient(135deg,var(--purple-1) 0%, #5b2be6 50%, var(--purple-2) 100%);
                display: flex;
                flex-direction: column;
                justify-content: space-between
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 14px;
                font-weight: 700
            }

                .brand .logo {
                    width: 44px;
                    height: 44px;
                    border-radius: 8px;
                    background: #ff9f1c;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    font-weight: 700
                }

            .hero {
                max-width: 640px
            }

            h1 {
                font-size: 64px;
                margin: 24px 0 8px;
                line-height: 0.9
            }

                h1 em {
                    font-style: normal;
                    color: #ffd166;
                    font-weight: 700
                }

            p.lead {
                color: rgba(255,255,255,0.9);
                max-width: 560px;
                font-size: 18px
            }

            .stats {
                display: flex;
                gap: 18px;
                margin-top: 40px
            }

            .stat {
                background: rgba(255,255,255,0.06);
                padding: 18px;
                border-radius: 12px;
                min-width: 160px;
                text-align: center
            }

                .stat .num {
                    font-size: 20px;
                    font-weight: 700;
                    color: #ffd166
                }

            .right {
                width: 460px;
                padding: 36px;
                background: #fff;
                border-radius: 18px;
                margin: 48px;
                align-self: center;
                box-shadow: 0 10px 30px rgba(0,0,0,0.12)
            }

            .card-title {
                font-size: 28px;
                margin: 0 0 6px;
                color: #111;
                font-weight: 700
            }

            .card-sub {
                color: #7b6f9b;
                margin-bottom: 18px
            }

            label {
                display: block;
                color: #4b4b4b;
                font-weight: 600;
                margin: 12px 0 6px
            }

            input[type="email"], input[type="password"] {
                width: 100%;
                padding: 14px 18px;
                border: 1px solid #eee;
                border-radius: 12px;
                font-size: 15px;
                box-sizing: border-box
            }

            .forgot {
                float: right;
                color: var(--accent);
                text-decoration: none;
                font-size: 14px;
                margin-top: 8px
            }

            .btn {
                display: inline-block;
                margin-top: 20px;
                width: 100%;
                padding: 14px;
                background: linear-gradient(90deg,var(--purple-2),var(--accent));
                color: #fff;
                border-radius: 12px;
                border: 0;
                font-weight: 700;
                cursor: pointer
            }

            .demo {
                margin-top: 20px;
                text-align: center;
                color: #bbb;
                font-size: 13px
            }

                .demo .roles {
                    display: flex;
                    gap: 12px;
                    justify-content: center;
                    margin-top: 10px
                }

            .role-btn {
                padding: 10px 14px;
                border-radius: 10px;
                border: 1px solid #eee;
                background: #fff;
                cursor: pointer
            }
            /* responsive */
            @@media(max-width:900px) {
                .container {
                    flex-direction: column
                }

                .right {
                    width: auto;
                    margin: 24px;
                    border-radius: 12px
                }

                h1 {
                    font-size: 44px
                }
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="left">
            <div>
                <div class="brand">
                    <div class="logo">★</div>
                    <div style="font-size:20px">BookMatch</div>
                </div>

                <div class="hero">
                    <h1>Tu biblioteca digital, <em>ilimitada.</em></h1>
                    <p class="lead">Descubre libros que te apasionan, publica tus obras y conecta con lectores de todo el mundo.</p>

                </div>
            </div>

            <div style="opacity:0.6;font-size:13px">© BookMatch</div>
        </div>

        <div class="right">
            <div>
                <h2 class="card-title">Iniciar Sesión</h2>
                <div class="card-sub">Accede a tu biblioteca personal</div>

                <form method="post">
                    @Html.AntiForgeryToken()
                    <label for="email">Correo electrónico</label>
                    <input id="email" asp-for="Email" type="email" placeholder="admin@bookmatch.com" required />

                    <label for="password">Contraseña</label>
                    <input id="password" asp-for="Password" type="password" placeholder="••••••••" required />

                    <a class="forgot" href="#">¿Olvidaste tu contraseña?</a>

                    <button class="btn" type="submit">Ingresar</button>
                </form>

                <div class="demo">
                    Acceso rápido (demo)
                    <div class="roles">
                        <button type="button" class="role-btn" onclick="fillDemo('admin')">👑 Administrador</button>
                        <button type="button" class="role-btn" onclick="fillDemo('user')">👤 Usuario/Autor</button>
                    </div>
                    <div style="margin-top:10px;color:#c5c5c5;font-size:13px">Contraseña demo: <strong>password123</strong></div>
                </div>
            </div>
        </div>
    </div>

    <script>
            function fillDemo(role) {
                var email = document.getElementById('email');
                var pass = document.getElementById('password');
                if (role === 'admin') {
                    email.value = 'admin@bookmatch.com';
                    pass.value = 'password123';
                } else {
                    email.value = 'autor@bookmatch.com';
                    pass.value = 'password123';
                }
            }
    </script>
</body>
</html>
